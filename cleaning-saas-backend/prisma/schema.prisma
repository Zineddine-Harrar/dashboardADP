// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Aggregated daily metrics for cleaning operations by zone
model DailyZoneCleaningMetrics {
  id                         Int      @id @default(autoincrement())
  
  // Date and Zone identification
  date                       DateTime @db.Date
  zoneId                     String   @db.VarChar(500)
  zoneName                   String   @db.VarChar(200)
  
  // Occurrences from visitBoundsExplanation parsing
  occurrencesMaintenance     Int?     @default(0)
  occurrencesAdditionnelles  Int?     @default(0)
  alertWOs                   Int?     @default(0)
  
  // PAX (passenger) metrics
  paxTotal                   Int?     @default(0)  // Per-zone PAX from CrowdInformation
  dailyTotalPax              Int?     @default(0)  // Daily total PAX from ScheduledFlight (departures + arrivals)
  
  // Duration metrics in seconds
  dureeMaintenanceSeconds    Int?     @default(0)
  dureeAdditionnelleSeconds  Int?     @default(0)
  dureeAlertesSeconds        Int?     @default(0) // For Alerts (ALERTE/SPM)
  dureeSpecificSeconds       Int?     @default(0) // For Specific tasks
  
  // Visit tracking (from ZoneKpi sheet)
  minVisits                  Int?     @default(0)
  maxVisits                  Int?     @default(0)
  nbVisits                   Int?     @default(0)
  
  // Metadata
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  
  // Unique constraint: one record per date/zone combination
  @@unique([date, zoneId])
  
  // Indexes for performance
  @@index([date])
  @@index([zoneId])
  
  @@map("daily_zone_cleaning_metrics")
}

/// Chat interaction logs for the AI chatbot
model ChatLog {
  id              Int       @id @default(autoincrement())
  
  // Interaction details
  question        String    @db.Text
  response        String?   @db.Text
  responseTimeMs  Int?
  success         Boolean   @default(true)
  errorMessage    String?   @db.Text
  
  // Context date (if question was about a specific date)
  dateContext     DateTime? @db.Date
  
  // User feedback
  userFeedback    Int?      // 1 = thumbs up, -1 = thumbs down, null = none
  feedbackDate    DateTime?
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@map("chat_logs")
  @@index([createdAt])
}
